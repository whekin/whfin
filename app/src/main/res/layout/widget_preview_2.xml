<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/widget_preview_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_preview_open">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_open_app_action"
                android:src="@drawable/ic_widget_app"
                android:tint="@color/widget_preview_secondary_text"
                tools:ignore="UseAppTint" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/widget_preview_account"
        android:textColor="@color/widget_preview_on_background"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_preview_add">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
            android:src="@drawable/ic_widget_add"
            android:tint="@color/widget_preview_on_action"
            tools:ignore="UseAppTint" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
